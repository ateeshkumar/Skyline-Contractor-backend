<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Services</title>
</head>
<body>
    <form method="POST" action="/listings/front" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <lable for="username" class="form-label">Username: </lable>
            <input name="listing[username]" placeholder="enter username" type="text" class="form-control" required/>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="email" class="form-label">E-mail id: </label>
                <input name="listing[email]" placeholder="enter email-id" type="text"class="form-control" required/>
            </div>

            <div class="mb-3 col-md-8">
                <label for="number" class="form-label"> Phone number: </label>
                <input name="listing[number]" placeholder="enter location" class="form-control" required/>
            </div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="age" class="form-label">Age: </label>
                <input name="listing[age]" placeholder="enter age" class="form-control" required/>
            </div>

            <div class="mb-3 col-md-8">
                <label for="state" class="form-label">State: </label>
                <input name="listing[state]" placeholder="enter state" type="text" class="form-control" required/>
            </div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-8">
                <label for="district" class="form-label">District: </label>
                <input name="listing[district]" placeholder="enter district" type="text" class="form-control" required/>
            </div>

            <div class="mb-3 col-md-4">
                <label for="pincode" class="form-label">Pincode: </label>
                <input name="listing[pincode]" placeholder="enter pincode" class="form-control" required/>
            </div>
        </div>

        <div class="mb-3">
            <label for="address" class="form-label">Address: </label>
            <textarea name="listing[address]" class="form-control" required></textarea>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="serviceType" class="form-label">Service Type: </label>
                <input name="listing[serviceType]" placeholder="enter serviceType" type="text" class="form-control" required/>
            </div>

            <div class="mb-3 col-md-8">
                <label for="serviceProvider" class="form-label">Service Provider: </label>
                <input name="listing[serviceProvider]" placeholder="enter serviceProvider" type="text" class="form-control" required/>
            </div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="experience" class="form-label">Year of Experience: </label>
                <input name="listing[experience]" placeholder="enter experience" class="form-control" required/>
            </div>

            <div class="mb-3 col-md-8">
                <label for="qualification" class="form-label">Qualification: </label>
                <input name="listing[qualification]" placeholder="enter qualification" type="text" class="form-control" required/>
            </div>
        </div>

        <div class="mb-3">
            <label for="serviceDescription" class="form-label">Service Description: </label>
            <textarea name="listing[serviceDescription]" class="form-control" required></textarea>
        </div>

            <div class="mb-3 col-md-4">
                <label for="charges" class="form-label">Charges: </label>
                <input name="listing[charges]" placeholder="enter charges in rupee" class="form-control" required/>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label" >Upload previous work: </label>
                <input name="listing[image]" type="file" class="form-control" required/>
            </div>

        <button class="btn btn-dark add-btn mt-3">Submit</button>
        <br/><br/>
    </form>
</body>
</html>